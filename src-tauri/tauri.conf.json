{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustRadar",
  "version": "0.3.0",
  "identifier": "com.felix.rustradar",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "RustRadar",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "backgroundColor": "#04060b",
        "maximized": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4RjA2Rjc5Njk4MUIxMUQKUldRZHNZRnBlVy93S05xU3BUY2sxM0V1VHdHQ2h4amlxVE1TTXpZN2l5MzJGS1JBaDM1dytjdXIK",
      "endpoints": [
        "https://github.com/felixgoff/RustRadar/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
